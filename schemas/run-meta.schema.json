{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunMeta",
  "type": "object",
  "required": ["run_id", "query", "route_id", "gate_level", "timestamp", "artifacts"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^\\d{8}-\\d{6}-[a-z0-9-]+$"},
    "query": {"type": "string"},
    "route_id": {"type": "string"},
    "gate_level": {"type": "string", "enum": ["P0", "P1", "P2"]},
    "timestamp": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "string"}}
  }
}
