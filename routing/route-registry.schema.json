{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QHSJ AIGC 全能影视 Route Registry Schema",
  "description": "验证多标签能力、依赖、工作流和资源注册表的关键结构。",
  "type": "object",
  "required": ["schema_version", "skill", "routing_contract", "capabilities", "workflows", "resources", "statistics"],
  "properties": {
    "schema_version": { "type": "string" },
    "skill": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "language_policy": { "type": "string" }, "routing_mode": { "type": "string" } }, "additionalProperties": true },
    "routing_contract": { "type": "object", "required": ["all_user_requests_must_route", "sequence", "alias_policy", "priority"], "properties": { "all_user_requests_must_route": { "type": "boolean" }, "sequence": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "parallel_rules": { "type": "string" }, "alias_policy": { "type": "string" }, "uncertainty_policy": { "type": "string" }, "priority": { "type": "string" } }, "additionalProperties": true },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name", "triggers", "dependencies", "reference_files"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "name": { "type": "string" }, "triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "reference_files": { "type": "array", "items": { "type": "string" } }, "selection_policy": { "type": "string" }, "priority": { "type": "string" } }, "additionalProperties": true } },
    "workflows": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name", "file", "triggers"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "file": { "type": "string" }, "triggers": { "type": "array", "items": { "type": "string" } }, "priority": { "type": "integer" }, "exclusive_when_explicit": { "type": "boolean" } }, "additionalProperties": true } },
    "resources": { "type": "array", "items": { "type": "object", "required": ["id", "file", "type", "tags", "triggers", "status", "sha256", "headings"], "properties": { "id": { "type": "string" }, "file": { "type": "string" }, "type": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "triggers": { "type": "array", "items": { "type": "string" } }, "status": { "type": "string", "enum": ["canonical", "alias", "retained_source"] }, "alias_of": { "type": ["string", "null"] }, "load_policy": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "headings": { "type": "array", "items": { "type": "object", "required": ["level", "heading", "anchor", "triggers"], "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 6 }, "heading": { "type": "string" }, "anchor": { "type": "string" }, "triggers": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true } } }, "additionalProperties": true } },
    "statistics": { "type": "object", "required": ["resource_count", "reference_markdown_count", "section_heading_count", "exact_duplicate_alias_count", "workflow_count"], "properties": { "resource_count": { "type": "integer", "minimum": 0 }, "reference_markdown_count": { "type": "integer", "minimum": 0 }, "section_heading_count": { "type": "integer", "minimum": 0 }, "exact_duplicate_alias_count": { "type": "integer", "minimum": 0 }, "workflow_count": { "type": "integer", "minimum": 0 } }, "additionalProperties": true }
  },
  "additionalProperties": true
}
