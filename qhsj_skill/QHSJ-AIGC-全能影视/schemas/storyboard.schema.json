{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QHSJ AIGC 全能影视 分镜表 Schema",
  "description": "逐镜分镜数据结构；显式锁定角色/场景/道具引用，记录空间位置、眼线、摄影机轨迹、起终态与资产连续性。",
  "type": "object",
  "required": [
    "project_id",
    "scene_id",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "3.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "time_of_day": {
      "type": "string"
    },
    "aspect_ratio": {
      "type": "string",
      "pattern": "^[0-9]+\\s*:\\s*[0-9]+$"
    },
    "frame_rate": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "scene_duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "characters_present": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "axis": {
      "type": "string",
      "description": "180度轴线方向、跨轴规则与明确的例外理由"
    },
    "continuity_locks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "duration",
          "framing"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "timecode_in": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?$"
          },
          "timecode_out": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?$"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "时长（秒），必须大于 0"
          },
          "framing": {
            "type": "string",
            "enum": [
              "大远景",
              "远景",
              "全景",
              "中全景",
              "中景",
              "中近景",
              "近景",
              "特写",
              "大特写"
            ]
          },
          "camera_angle": {
            "type": "string",
            "description": "拍摄角度：平拍/俯拍/仰拍等"
          },
          "camera_movement": {
            "type": "string",
            "description": "运镜方式、起止点和速度变化"
          },
          "focal_length": {
            "type": "string",
            "description": "焦段"
          },
          "depth_of_field": {
            "type": "string",
            "description": "景深"
          },
          "composition": {
            "type": "string"
          },
          "subject_action": {
            "type": "string",
            "description": "可观察、可执行的主体动作"
          },
          "reaction": {
            "type": "string",
            "description": "对手或环境的可见反应"
          },
          "environment_motion": {
            "type": "string",
            "description": "环境动态"
          },
          "lighting": {
            "type": "string",
            "description": "光线描述"
          },
          "sound": {
            "type": "string",
            "description": "对白、环境音、拟音、配乐和静音的分层描述"
          },
          "dialogue": {
            "type": "string",
            "description": "台词"
          },
          "emotion": {
            "type": "string",
            "description": "情绪状态；关键情绪需同步给出可见/可听表演线索"
          },
          "transition": {
            "type": "string",
            "description": "转场方式及衔接理由"
          },
          "continuity_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "continuity_out": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negative_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_prompt": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "导演备注"
          },
          "character_asset_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "scene_asset_ref": {
            "type": "string"
          },
          "prop_asset_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "actor_states": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/actor_state"
            }
          },
          "camera_position": {
            "type": "object"
          },
          "camera_orientation": {
            "type": "object"
          },
          "camera_path": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "gaze_relations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subject_id": {
                  "type": "string"
                },
                "target_id": {
                  "type": "string"
                },
                "head_direction": {
                  "type": "string"
                },
                "eye_direction": {
                  "type": "string"
                },
                "time_range": {
                  "type": "string"
                }
              },
              "required": [
                "subject_id",
                "target_id"
              ]
            }
          },
          "distance_constraints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "state_in": {
            "type": "object"
          },
          "state_out": {
            "type": "object"
          },
          "asset_mutations_allowed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asset_mutations_forbidden": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "continuity_validation": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "passed",
                  "failed",
                  "blocked"
                ]
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "asset_catalog_version": {
      "type": "string"
    },
    "character_asset_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scene_asset_ref": {
      "type": "string"
    },
    "prop_asset_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "coordinate_system": {
      "type": "object",
      "description": "原点、轴向、单位、固定锚点与尺度来源。"
    },
    "scene_anchors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "asset_lock_status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "locked",
        "locked_provisional",
        "superseded",
        "blocked",
        "needs_recheck"
      ]
    }
  },
  "additionalProperties": true,
  "definitions": {
    "actor_state": {
      "type": "object",
      "required": [
        "character_id"
      ],
      "properties": {
        "character_id": {
          "type": "string"
        },
        "asset_version": {
          "type": "string"
        },
        "position": {
          "type": "object"
        },
        "screen_position": {
          "type": "string"
        },
        "body_orientation": {
          "type": "string"
        },
        "head_orientation": {
          "type": "string"
        },
        "gaze_target_id": {
          "type": "string"
        },
        "eye_line": {
          "type": "string"
        },
        "held_prop_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action_phase": {
          "type": "string"
        },
        "center_of_mass": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
